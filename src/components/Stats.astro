---
import Icon from './Icon.astro';
import { stats } from '../data/site.js';
const { plain = false } = Astro.props;
---
<section class="stats" aria-label="Rakamlarla Aygur Tur">
  <div class="wrap">
    {stats.map((s) => (
      <div class="stat">
        <span class="stat-ico"><Icon name={s.icon} size={26} /></span>
        <div><strong>{plain ? s.value.replace('+', '') : s.value}</strong><span>{s.label}</span></div>
      </div>
    ))}
  </div>
</section>
