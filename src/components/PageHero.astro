---
const { title, crumbs = [], tag = 'h1' } = Astro.props;
const Tag = tag;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<section class="page-hero">
  <svg class="shape top" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true"><path d="M500.2,94.7L0,0v100h1000V0L500.2,94.7z"/></svg>
  <div class="wrap">
    <Tag class="ph-title">{title}</Tag>
    <nav class="crumbs" aria-label="Konum"><a href={base}>Anasayfa</a>{crumbs.map((c) => c.href ? <> / <a href={c.href}>{c.name}</a></> : <> / <span aria-current="page">{c.name}</span></>)}</nav>
  </div>
  <svg class="shape bottom" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0,6V0h1000v100L0,6z"/></svg>
</section>
