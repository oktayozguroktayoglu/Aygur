---
// Sağ altta sabit iletişim butonu: WhatsApp, e-posta, arama, yol tarifi
import { PHONE, PHONE_TEL, EMAIL, WA_NUMBER, ADDRESS } from '../data/site.js';
const wa = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent('Merhaba, Aygur Turizm hizmetleri hakkında bilgi almak istiyorum.')}`;
const mail = `mailto:${EMAIL}?subject=${encodeURIComponent('Web sitesi üzerinden bilgi talebi')}`;
const maps = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(ADDRESS)}`;
const items = [
  { href: wa, label: 'WhatsApp', sub: 'Mesaj gönderin', cls: 'wa', ext: true, d: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.4-.3z' },
  { href: mail, label: 'E-posta', sub: EMAIL, cls: 'mail', d: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.3V17h16V7.3l-8 5.5-8-5.5zM5.4 7l6.6 4.5L18.6 7H5.4z' },
  { href: PHONE_TEL, label: 'Ara', sub: PHONE, cls: 'tel', d: 'M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z' },
  { href: maps, label: 'Yol Tarifi', sub: 'Google Haritalar', cls: 'map', ext: true, d: 'M12 2a7 7 0 0 0-7 7c0 5.3 7 13 7 13s7-7.7 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z' },
];
---
<div class="fab" id="fab">
  <ul class="fab-menu" id="fab-menu" hidden>
    {items.map((i) => (
      <li><a class={`fab-item ${i.cls}`} href={i.href} target={i.ext ? '_blank' : undefined} rel={i.ext ? 'noopener' : undefined}>
        <span class="fab-txt"><strong>{i.label}</strong><small>{i.sub}</small></span>
        <span class="fab-ico"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d={i.d} /></svg></span>
      </a></li>
    ))}
  </ul>
  <button class="fab-btn" type="button" aria-expanded="false" aria-controls="fab-menu" aria-label="İletişim seçeneklerini aç">
    <svg class="i-open" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2zm3 6a1.3 1.3 0 1 0 0 2.6A1.3 1.3 0 0 0 7 10zm5 0a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6zm5 0a1.3 1.3 0 1 0 0 2.6 1.3 1.3 0 0 0 0-2.6z"/></svg>
    <svg class="i-close" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" d="M6 6l12 12M18 6 6 18"/></svg>
  </button>
</div>
<script is:inline>
  (function () {
    var f = document.getElementById('fab'); if (!f) return;
    var b = f.querySelector('.fab-btn'), m = document.getElementById('fab-menu'), ctx;

    // Araba çalıştırma sesi (Web Audio ile üretilir, dosya yok): marş + motorun tutması + rölanti
    function engineStart() {
      try {
        var AC = window.AudioContext || window.webkitAudioContext; if (!AC) return;
        ctx = ctx || new AC(); if (ctx.state === 'suspended') ctx.resume();
        var t = ctx.currentTime + 0.02;
        var out = ctx.createGain(); out.gain.value = 0.32;
        var lp = ctx.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = 1100;
        lp.connect(out); out.connect(ctx.destination);
        function osc(type, f) { var o = ctx.createOscillator(); o.type = type; o.frequency.setValueAtTime(f, t); return o; }

        // 1) Marş motoru: tırtıklı "vın-vın-vın"
        var st = osc('sawtooth', 120); st.frequency.linearRampToValueAtTime(165, t + 0.6);
        var stG = ctx.createGain(); stG.gain.setValueAtTime(0.0001, t);
        stG.gain.linearRampToValueAtTime(0.32, t + 0.06); stG.gain.setValueAtTime(0.32, t + 0.55); stG.gain.linearRampToValueAtTime(0.0001, t + 0.68);
        var lfo = osc('square', 11); var lfoG = ctx.createGain(); lfoG.gain.value = 0.18;
        lfo.connect(lfoG); lfoG.connect(stG.gain); st.connect(stG); stG.connect(lp);
        st.start(t); lfo.start(t); st.stop(t + 0.7); lfo.stop(t + 0.7);

        // 2) Motor tutar, gaz verir, rölantiye düşer
        var e0 = t + 0.6, e1 = osc('sawtooth', 28), e2 = osc('square', 14);
        [e1, e2].forEach(function (o, i) {
          var k = i ? 0.5 : 1;
          o.frequency.setValueAtTime(28 * k, e0);
          o.frequency.exponentialRampToValueAtTime(92 * k, e0 + 0.28);
          o.frequency.exponentialRampToValueAtTime(40 * k, e0 + 0.95);
          o.frequency.setValueAtTime(40 * k, e0 + 1.6);
        });
        var eG = ctx.createGain(); eG.gain.setValueAtTime(0.0001, e0);
        eG.gain.linearRampToValueAtTime(0.5, e0 + 0.08); eG.gain.setValueAtTime(0.5, e0 + 0.7);
        eG.gain.linearRampToValueAtTime(0.28, e0 + 1.0); eG.gain.exponentialRampToValueAtTime(0.0001, e0 + 1.65);
        var put = osc('sine', 7); put.frequency.exponentialRampToValueAtTime(24, e0 + 0.28); put.frequency.exponentialRampToValueAtTime(10, e0 + 0.95);
        var putG = ctx.createGain(); putG.gain.value = 0.22; put.connect(putG); putG.connect(eG.gain);
        e1.connect(eG); e2.connect(eG); eG.connect(lp);
        [e1, e2, put].forEach(function (o) { o.start(e0); o.stop(e0 + 1.7); });

        // 3) Yanma gürültüsü (doku)
        var len = Math.floor(ctx.sampleRate * 1.7), buf = ctx.createBuffer(1, len, ctx.sampleRate), d = buf.getChannelData(0);
        for (var i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
        var n = ctx.createBufferSource(); n.buffer = buf;
        var bp = ctx.createBiquadFilter(); bp.type = 'bandpass'; bp.frequency.value = 320; bp.Q.value = 0.8;
        var nG = ctx.createGain(); nG.gain.setValueAtTime(0.0001, e0); nG.gain.linearRampToValueAtTime(0.12, e0 + 0.1);
        nG.gain.linearRampToValueAtTime(0.05, e0 + 1.0); nG.gain.exponentialRampToValueAtTime(0.0001, e0 + 1.6);
        n.connect(bp); bp.connect(nG); nG.connect(lp); n.start(e0); n.stop(e0 + 1.7);
      } catch (_) {}
    }

    function set(o) {
      f.classList.toggle('open', o); m.hidden = !o;
      b.setAttribute('aria-expanded', o);
      b.setAttribute('aria-label', o ? 'İletişim seçeneklerini kapat' : 'İletişim seçeneklerini aç');
    }
    b.addEventListener('click', function () { var o = !f.classList.contains('open'); set(o); if (o) engineStart(); });
    document.addEventListener('click', function (e) { if (!f.contains(e.target)) set(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { set(false); b.focus(); } });
    m.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { set(false); }); });
    set(false);
  })();
</script>
