---
import { img } from '../data/site.js';
const { ids, alt = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<div class="image-pair">
  {ids.map((id, i) => <img src={base + img(id)} alt={alt} loading={i === 0 ? 'eager' : 'lazy'} width="1024" height="683" />)}
</div>
