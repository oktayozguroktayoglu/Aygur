---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { img, srcset } from '../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date - a.data.date);
const fmt = (d) => d.toLocaleDateString('tr-TR', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Europe/Istanbul' });
---
<Base title="Bilgi Bankası | Aygur Turizm Blog" description="Sektörel gelişmeler, güncel makaleler ve hizmetlerimiz hakkında bilgilendirici yazılar: personel, öğrenci servisi, transfer, turizm taşımacılığı ve araç kiralama.">
  <PageHero title="BİLGİ VE MAKALELER" crumbs={[{ name: 'Blog' }]} />
  <section class="section">
    <div class="wrap">
      <h2>Bilgi ve Makaleler</h2>
      <ul class="taglines">
        <li>“Sektörel gelişmeler ve kurumsal içeriklerimizi inceleyin.”</li>
        <li>“Güncel makaleler ve profesyonel içerikler burada.”</li>
        <li>“Hizmetlerimiz ve sektör hakkında bilgilendirici yazılar.”</li>
        <li>“Kurumsal içerikler ve güncel paylaşımlar.”</li>
        <li>“Sektörel yazılar ve profesyonel bilgilendirmeler.”</li>
      </ul>
      <div class="post-list">
        {posts.map((p) => (
          <article class={`post-row${p.data.cover ? ' has-thumb' : ''}`}>
            {p.data.cover && <a class="post-thumb" href={`${base}${p.id}/`} tabindex="-1" aria-hidden="true"><img src={`${base}${img(p.data.cover)}`} srcset={srcset(base, p.data.cover)} sizes="(max-width: 700px) 100vw, 280px" alt="" width="1600" height="1067" loading="lazy" /></a>}
            <div class="post-row-body">
            <time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time>
            <h3><a href={`${base}${p.id}/`}>{p.data.title}</a></h3>
            <p>{p.data.description}</p>
            <a class="card-more" href={`${base}${p.id}/`}>Devamını oku</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
