---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Stats from '../components/Stats.astro';
import Values from '../components/Values.astro';
import InfoCard from '../components/InfoCard.astro';
import { img, srcset } from '../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title="Değerlerimiz | Aygur Turizm" description="Faaliyetlerimizin temelinde güven, kalite ve sürdürülebilir hizmet anlayışı yer almaktadır. Aygur Turizm değerleri." ogImage="img/6592700.jpg">
  <PageHero title="DEĞERLERİMİZ" crumbs={[{ name: 'Hakkımızda', href: `${base}hakkimizda/` }, { name: 'Değerlerimiz' }]} />
  <section class="section">
    <div class="wrap split">
      <h4 class="statement">Faaliyetlerimizin temelinde güven, kalite ve sürdürülebilir hizmet anlayışı yer almaktadır. Müşteri memnuniyetini ön planda tutarak benimsediğimiz değerler, hizmet kalitemizi ve çalışma prensiplerimizi şekillendirmektedir.</h4>
      <img class="rounded" src={base + img('6592700')} srcset={srcset(base, '6592700')} sizes="(max-width: 900px) 100vw, 600px" alt="" width="1024" height="682" />
    </div>
  </section>
  <section class="section"><div class="wrap"><Values /></div></section>
  <Stats />
  <section class="section"><div class="wrap"><img class="rounded wide" src={base + img('8353820')} srcset={srcset(base, '8353820')} sizes="(max-width: 900px) 100vw, 600px" alt="" width="1024" height="684" loading="lazy" /></div></section>
  <InfoCard />
</Base>
