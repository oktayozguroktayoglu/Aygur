---
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/600.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import ContactFab from '../components/ContactFab.astro';
import { SITE_NAME, PHONE, PHONE_TEL, EMAIL, ADDRESS, TAGLINE, ABOUT_SHORT, services } from '../data/site.js';

interface Props { title: string; description: string; jsonLd?: object; noindex?: boolean; ogImage?: string }
const { title: rawTitle, description: rawDesc, jsonLd, noindex = false, ogImage } = Astro.props;
// Google'da kesilmesin: başlık ~60, açıklama ~155 karakter
const SUF = ' | Aygur Turizm';
let title = rawTitle;
if (title.length > 62 && title.endsWith(SUF)) title = title.slice(0, -SUF.length);
if (title.length > 65) title = title.slice(0, 62).replace(/[\s:,;–-]+\S*$/, '') + '…';
const description = rawDesc.length > 158 ? rawDesc.slice(0, 155).replace(/\s+\S*$/, '') + '…' : rawDesc;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const u = (p = '') => base + p;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const is = (p) => path === u(p);
const aboutPages = [
  { href: 'biz-kimiz/', name: 'Biz Kimiz' },
  { href: 'vizyon-ve-misyonumuz/', name: 'Vizyon ve Misyon' },
  { href: 'degerlerimiz/', name: 'Değerlerimiz' },
];
const inAbout = is('hakkimizda/') || aboutPages.some((a) => is(a.href));
const inServices = is('hizmetlerimiz/') || services.some((s) => is(s.slug + '/'));
const org = {
  '@context': 'https://schema.org', '@type': 'LocalBusiness', '@id': new URL(base, Astro.site).href + '#firma',
  name: 'Aygur Turizm', alternateName: 'Aygur Tur', url: new URL(base, Astro.site).href, telephone: '+905332847518', email: EMAIL,
  address: { '@type': 'PostalAddress', streetAddress: 'Merkez Mah. Vezir Sk. No:17 D:3', addressLocality: 'Çekmeköy', addressRegion: 'İstanbul', addressCountry: 'TR' },
  description: ABOUT_SHORT,
};
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={new URL(ogImage, new URL(base, Astro.site)).href} />}
  <link rel="icon" href={u('favicon.png')} />
  <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip" href="#content">İçeriğe atla</a>
  <div class="topbar">
    <div class="wrap">
      <span>{TAGLINE}</span>
      <span class="tb-links"><a href={`mailto:${EMAIL}`}><Icon name="mail" size={16} /> {EMAIL}</a><a href={PHONE_TEL}><Icon name="phone" size={16} /> {PHONE}</a></span>
    </div>
  </div>
  <header class="site-header">
    <div class="wrap">
      <a href={u()} class="brand" aria-label="Aygur Turizm anasayfa"><Logo /></a>
      <nav class="main-nav" aria-label="Ana menü">
        <ul>
          <li><a href={u()} aria-current={is('') ? 'page' : undefined}>Anasayfa</a></li>
          <li class="has-sub"><a href={u('hakkimizda/')} aria-current={inAbout ? 'page' : undefined}>Hakkımızda</a>
            <ul class="sub">{aboutPages.map((a) => <li><a href={u(a.href)}>{a.name}</a></li>)}</ul>
          </li>
          <li class="has-sub"><a href={u('hizmetlerimiz/')} aria-current={inServices ? 'page' : undefined}>Hizmetlerimiz</a>
            <ul class="sub">{services.map((s) => <li><a href={u(s.slug + '/')}>{s.title}</a></li>)}</ul>
          </li>
          <li><a href={u('referanslar/')} aria-current={path.startsWith(u('referanslar')) ? 'page' : undefined}>Referanslar</a></li>
          <li><a href={u('bilgi-bankasi/')} aria-current={path.startsWith(u('bilgi-bankasi')) ? 'page' : undefined}>Blog</a></li>
          <li><a href={u('iletisim/')} aria-current={is('iletisim/') ? 'page' : undefined}>İletişim</a></li>
        </ul>
      </nav>
      <a class="header-cta" href={PHONE_TEL}><span class="cta-ico"><Icon name="phone" size={20} /></span><span><small>Size Nasıl Yardımcı Olabiliriz?</small><strong>{PHONE}</strong></span></a>
      <details class="mobile-menu">
        <summary aria-label="Menüyü aç"><span class="burger" aria-hidden="true"></span></summary>
        <div class="mm-panel">
          <a href={u()}>Anasayfa</a>
          <a href={u('hakkimizda/')}>Hakkımızda</a>
          {aboutPages.map((a) => <a class="sub" href={u(a.href)}>{a.name}</a>)}
          <a href={u('hizmetlerimiz/')}>Hizmetlerimiz</a>
          {services.map((s) => <a class="sub" href={u(s.slug + '/')}>{s.title}</a>)}
          <a href={u('referanslar/')}>Referanslar</a>
          <a href={u('bilgi-bankasi/')}>Blog</a>
          <a href={u('iletisim/')}>İletişim</a>
          <a class="btn" href={PHONE_TEL}>Hemen Ara: {PHONE}</a>
        </div>
      </details>
    </div>
  </header>
  <main id="content"><slot /></main>
  <footer class="site-footer">
    <div class="wrap">
      <div class="f-about"><Logo variant="footer" /><p>{ABOUT_SHORT}</p></div>
      <div><h2>MENU</h2><ul><li><a href={u('hakkimizda/')}>Hakkımızda</a></li><li><a href={u('hizmetlerimiz/')}>Hizmetlerimiz</a></li><li><a href={u('referanslar/')}>Referanslarımız</a></li><li><a href={u('iletisim/')}>İletişim</a></li></ul></div>
      <div><h2>Hizmetlerimiz</h2><ul>{services.map((s) => <li><a href={u(s.slug + '/')}>{s.title}</a></li>)}</ul></div>
      <div class="f-contact">
        <p><Icon name="pin" size={18} /> <span>Adres: {ADDRESS}</span></p>
        <p><Icon name="mail" size={18} /> <a href={`mailto:${EMAIL}`}>E-mail: {EMAIL}</a></p>
        <p><Icon name="phone" size={18} /> <a href={PHONE_TEL}>Gsm : +90 533 284 75 18</a></p>
      </div>
    </div>
    <div class="wrap copy">© {new Date().getFullYear()} Aygur Turizm. Tüm hakları saklıdır.<a href="#content" class="to-top">Yukarı çık ↑</a></div>
  </footer>
  <ContactFab />
  <script is:inline>
    (function(){var m=document.querySelector('.mobile-menu');if(!m)return;document.addEventListener('click',function(e){if(m.open&&!m.contains(e.target))m.open=false;});m.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){m.open=false;});});document.addEventListener('keydown',function(e){if(e.key==='Escape')m.open=false;});})();
  </script>
  <script is:inline>
    (function(){
      if(!('IntersectionObserver' in window)||window.matchMedia('(prefers-reduced-motion: reduce)').matches)return;
      var items=document.querySelectorAll('main > section:not(.hero)');
      if(!items.length)return;
      var io=new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if(!en.isIntersecting)return;
          var el=en.target;
          el.classList.add('is-open');
          io.unobserve(el);
          setTimeout(function(){el.querySelectorAll('.reveal-strip').forEach(function(s){s.remove();});},1600);
        });
      },{threshold:0.15,rootMargin:'0px 0px -8% 0px'});
      items.forEach(function(el){
        var bg=getComputedStyle(el).backgroundColor;
        if(!bg||bg==='rgba(0, 0, 0, 0)'||bg==='transparent')bg='#fff';
        el.classList.add('reveal-page');
        for(var i=1;i<=3;i++){
          var s=document.createElement('span');
          s.className='reveal-strip reveal-strip-'+i;
          s.style.background=bg;
          el.appendChild(s);
        }
        io.observe(el);
      });
    })();
  </script>
</body>
</html>
